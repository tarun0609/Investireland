# Copy to .env (never commit .env). Every variable is optional for local development.

# --- Server ---
# PORT=3000
# NODE_ENV=production            # enables CSP, static serving of dist/, and disables test mail inboxes
# APP_URL="https://your-app.example.com"   # used for links inside transactional emails

# --- Firebase (server-side ID token verification) ---
# Defaults to projectId in firebase-applet-config.json. No service account is needed to verify ID tokens.
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# Set to true only when Admin SDK credentials are available (enables revoked-token checks).
# FIREBASE_CHECK_REVOKED=false

# --- AI assistant (Gemini) ---
# Without a key the assistant answers from a built-in offline knowledge base.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.8-flash"
# Signed-out visitors get offline answers unless this is true (protects your Gemini quota).
# ALLOW_ANONYMOUS_AI=false

# --- Transactional email (SMTP) ---
# Without SMTP: development uses an Ethereal test inbox (preview only); production does not send mail.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=465                  # 465 = implicit TLS; 587 = STARTTLS
# SMTP_USER=""
# SMTP_PASS=""
# SYSTEM_DISPATCHER_EMAIL="InvestIreland <no-reply@example.com>"