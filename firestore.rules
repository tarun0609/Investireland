rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny. Every allowed path is listed explicitly below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function tokenEmail() {
      return request.auth.token.get('email', '').lower();
    }

    // Fields only the trusted backend (Admin SDK) may set.
    function serverManagedUserFields() {
      return ['welcomeEmailSent', 'welcomeEmailDispatchedAt'];
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] == null ||
             (data[field] is number && data[field] >= 0 && data[field] < 1000000000000);
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'country', 'registeredAt']) &&
             data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email == tokenEmail() &&
             data.country is string && data.country.size() <= 100 &&
             data.registeredAt is string && data.registeredAt.size() <= 40 &&
             optionalNumber(data, 'targetLifeGoalAmount');
    }

    function isValidHolding(data, holdingId) {
      return data.keys().hasAll(['holdingId', 'userId', 'name', 'category', 'currency']) &&
             data.holdingId == holdingId &&
             data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
             data.category is string && data.category.size() <= 60 &&
             data.currency in ['EUR', 'INR', 'USD', 'GBP'] &&
             optionalNumber(data, 'units') &&
             optionalNumber(data, 'unitPrice') &&
             optionalNumber(data, 'currentValue') &&
             optionalNumber(data, 'purchaseValue') &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('provider' in data) || (data.provider is string && data.provider.size() <= 100)) &&
             (!('ticker' in data) || (data.ticker is string && data.ticker.size() <= 20)) &&
             (!('isin' in data) || (data.isin is string && data.isin.size() <= 12)) &&
             (!('country' in data) || data.country in ['Ireland', 'India', 'US', 'Europe', 'Other']);
    }

    function isValidMilestone(data, milestoneId) {
      return data.keys().hasAll(['milestoneId', 'userId', 'title', 'targetAmountEUR']) &&
             data.milestoneId == milestoneId &&
             data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.targetAmountEUR is number && data.targetAmountEUR >= 0 &&
             optionalNumber(data, 'currentAmountEUR');
    }

    function isValidAccount(data) {
      return data.keys().hasAll(['accountValue', 'annualContributions', 'annualLimit']) &&
             data.accountValue is number && data.accountValue >= 0 &&
             data.annualContributions is number && data.annualContributions >= 0 &&
             data.annualLimit is number && data.annualContributions <= data.annualLimit &&
             (!('history' in data) || (data.history is list && data.history.size() <= 500));
    }

    // Household partners on an active Family plan can read each other's holdings.
    // Entitlements are written only by the backend Worker, so clients cannot grant themselves access.
    function isHouseholdPartnerOf(userId) {
      let ent = get(/databases/$(database)/documents/entitlements/$(userId)).data;
      return isSignedIn() && request.auth.uid != userId &&
             ent.get('householdPartner', '') == request.auth.uid &&
             ent.get('plan', 'free') == 'family' &&
             ent.get('planExpiresAt', null) is timestamp &&
             ent.planExpiresAt > request.time;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(request.resource.data) &&
                       !request.resource.data.keys().hasAny(serverManagedUserFields());
      allow update: if isOwner(userId) && isValidId(userId) &&
                       isValidUser(request.resource.data) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverManagedUserFields());
      allow delete: if isOwner(userId) && isValidId(userId);

      match /holdings/{holdingId} {
        allow get, list: if isOwner(userId) || (isValidId(userId) && isHouseholdPartnerOf(userId));
        allow create, update: if isOwner(userId) && isValidId(holdingId) && isValidHolding(request.resource.data, holdingId);
        allow delete: if isOwner(userId) && isValidId(holdingId);
      }

      match /milestones/{milestoneId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(milestoneId) && isValidMilestone(request.resource.data, milestoneId);
        allow delete: if isOwner(userId) && isValidId(milestoneId);
      }

      // Email audit records are written only by the backend (Admin SDK bypasses rules).
      match /emails/{emailId} {
        allow get, list: if isOwner(userId);
        allow write: if false;
      }

      match /accounts/{accountId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && accountId == 'budget2027_investment_account' && isValidAccount(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(accountId);
      }
    }

    // Plan, promo and billing state. Written only by the backend Worker (service account bypasses rules).
    match /entitlements/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list, write: if false;
    }

    // Marketing email preference. Users can change their own; the Worker also writes it from unsubscribe links.
    match /emailOptOuts/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) &&
                               request.resource.data.keys().hasOnly(['uid', 'optedOut', 'updatedAt']) &&
                               request.resource.data.uid == userId &&
                               request.resource.data.optedOut is bool &&
                               request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // promoCodes, promoRedemptions, counters, households and emailCampaigns stay server-only (default deny).
  }
}
