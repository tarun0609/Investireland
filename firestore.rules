rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'country', 'registeredAt']) &&
             data.uid is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.email is string && data.email.size() <= 200 &&
             data.country is string && data.country.size() <= 100 &&
             data.registeredAt is string;
    }

    function isValidHolding(data) {
      return data.keys().hasAll(['holdingId', 'userId', 'name', 'category', 'currency']) &&
             data.holdingId is string &&
             data.userId is string &&
             data.name is string && data.name.size() <= 150 &&
             data.category is string &&
             data.currency is string;
    }

    function isValidMilestone(data) {
      return data.keys().hasAll(['milestoneId', 'userId', 'title', 'targetAmountEUR']) &&
             data.milestoneId is string &&
             data.userId is string &&
             data.title is string && data.title.size() <= 200 &&
             data.targetAmountEUR is number;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && request.resource.data.uid == request.auth.uid && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && request.resource.data.uid == request.auth.uid && isValidUser(request.resource.data);
      allow delete: if isOwner(userId) && isValidId(userId);

      // User portfolio investment holdings
      match /holdings/{holdingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(holdingId) && request.resource.data.userId == request.auth.uid && isValidHolding(request.resource.data);
        allow update: if isOwner(userId) && isValidId(holdingId) && request.resource.data.userId == request.auth.uid && isValidHolding(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(holdingId);
      }

      // User life stage financial milestones
      match /milestones/{milestoneId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(milestoneId) && request.resource.data.userId == request.auth.uid && isValidMilestone(request.resource.data);
        allow update: if isOwner(userId) && isValidId(milestoneId) && request.resource.data.userId == request.auth.uid && isValidMilestone(request.resource.data);
        allow delete: if isOwner(userId) && isValidId(milestoneId);
      }

      // Transactional email dispatch audit records
      match /emails/{emailId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(emailId);
        allow update, delete: if false;
      }
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }
  }
}
